# AssemblyAI: one key covers speech-to-text (Universal-3.6 Pro Realtime) and text-to-speech
# Get one at https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your_assemblyai_key

# OpenAI: the LLM (GPT-4o)
OPENAI_API_KEY=your_openai_key

# LiveKit Cloud: not needed for console mode, only to connect to LiveKit (dev mode)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
